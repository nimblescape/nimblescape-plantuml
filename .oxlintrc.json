// The linter (`npm run lint`): the rules of the category "correctness", with the rules that need the types, such as
// typescript/no-floating-promises. The rules of the vitest plugin are off: they do not allow the message argument of
// `expect`, which the tests use.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "stdlib/**", "*.vsix"]
}
