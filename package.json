{
  "name": "nimblescape-plantuml",
  "displayName": "nimblescape PlantUML",
  "description": "Renders PlantUML diagrams in VS Code with the PlantUML engine compiled to JavaScript: no Java, no Graphviz installation and no server.",
  "publisher": "nimblescape",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "plantuml",
    "uml",
    "diagram",
    "puml",
    "markdown"
  ],
  "license": "MIT",
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/nimblescape-plantuml.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/nimblescape-plantuml/issues"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1a365d",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links"
  },
  "dependencies": {
    "@plantuml/core": "1.2026.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.125.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "markdown-it": "^14.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onWebviewPanel:nimblescape.plantuml.sidePreview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension reads PlantUML text to show it and runs no program of the workspace."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      {
        "path": "./dist/markdownPreview.js",
        "type": "module"
      }
    ],
    "markdown.previewStyles": [
      "./media/markdownPreview.css"
    ],
    "languages": [
      {
        "id": "plantuml",
        "aliases": [
          "PlantUML",
          "plantuml"
        ],
        "extensions": [
          ".puml",
          ".plantuml",
          ".pu",
          ".iuml",
          ".wsd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plantuml",
        "scopeName": "source.plantuml",
        "path": "./dist/syntaxes/plantuml.tmLanguage.json"
      },
      {
        "scopeName": "markdown.plantuml.codeblock",
        "path": "./dist/syntaxes/markdown-plantuml.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.plantuml": "plantuml"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "nimblescape.plantuml.preview",
        "displayName": "PlantUML Preview",
        "selector": [
          {
            "filenamePattern": "*.puml"
          },
          {
            "filenamePattern": "*.plantuml"
          },
          {
            "filenamePattern": "*.pu"
          },
          {
            "filenamePattern": "*.iuml"
          },
          {
            "filenamePattern": "*.wsd"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "nimblescape.plantuml.togglePreview",
        "title": "Toggle Preview",
        "category": "PlantUML"
      },
      {
        "command": "nimblescape.plantuml.reopenAsPreview",
        "title": "Open as Preview",
        "category": "PlantUML",
        "icon": "$(preview)"
      },
      {
        "command": "nimblescape.plantuml.reopenAsSource",
        "title": "Reopen as Source",
        "category": "PlantUML",
        "icon": "$(file-code)"
      },
      {
        "command": "nimblescape.plantuml.showPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "PlantUML",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nimblescape.plantuml.reopenAsPreview",
          "alt": "nimblescape.plantuml.showPreviewToSide",
          "when": "resourceLangId == plantuml && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "nimblescape.plantuml.reopenAsSource",
          "when": "activeCustomEditorId == 'nimblescape.plantuml.preview'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nimblescape.plantuml.togglePreview",
          "when": "resourceLangId == plantuml || activeCustomEditorId == 'nimblescape.plantuml.preview'"
        },
        {
          "command": "nimblescape.plantuml.reopenAsPreview",
          "when": "resourceLangId == plantuml && !activeCustomEditorId"
        },
        {
          "command": "nimblescape.plantuml.reopenAsSource",
          "when": "activeCustomEditorId == 'nimblescape.plantuml.preview'"
        },
        {
          "command": "nimblescape.plantuml.showPreviewToSide",
          "when": "resourceLangId == plantuml || activeCustomEditorId == 'nimblescape.plantuml.preview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nimblescape.plantuml.togglePreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "(editorLangId == plantuml && !notebookEditorFocused) || activeCustomEditorId == 'nimblescape.plantuml.preview'"
      },
      {
        "command": "nimblescape.plantuml.showPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "(editorLangId == plantuml && !notebookEditorFocused) || activeCustomEditorId == 'nimblescape.plantuml.preview'"
      }
    ],
    "configuration": {
      "title": "nimblescape PlantUML",
      "properties": {
        "nimblescape.plantuml.classIcons": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show the colored icons of PlantUML in class diagrams: the circled letter of the kind of a class (C, I, E, A …) and the icons of the visibility of attributes and methods. The value `false` shows the UML notation instead: a keyword such as «interface» or «enumeration» above the name, and the characters `-` private, `#` protected, `~` package private and `+` public. A diagram that sets `hide circle`, `show circle` or `skinparam classAttributeIconSize` itself keeps its own value."
        }
      }
    }
  }
}
